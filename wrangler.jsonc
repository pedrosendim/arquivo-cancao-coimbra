// Configuração da Cloudflare (Workers Builds): a cada alteração no ramo main, a Cloudflare corre
// «python3 scripts/construir.py» (gera site/dados/base.json) e depois «npx wrangler deploy».
// Segredos (Settings › Variables and Secrets, tipo «Secret»): GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GITHUB_TOKEN.
// Endereço: <name>.<subdomínio da conta>.workers.dev
{
  "name": "arquivo-cancao-coimbra",
  "main": "online/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // só os pedidos à API e a página inicial («/», para a política de segurança dos scripts, online/cabecalhos.js)
    // passam pelo Worker; o resto (código, estilos, dados, imagens) serve-se diretamente (e de graça), com site/_headers
    "run_worker_first": ["/api/*", "/"]
  },
  "workers_dev": true,
  // não apagar as variáveis postas no painel da Cloudflare quando se publica
  "keep_vars": true,
  "observability": { "enabled": true }
}
